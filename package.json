{
  "name": "ramp",
  "version": "1.0.0",
  "private": true,
  "description": "Interview-focused upskilling for the JS/TS/React/Node and C#/.NET stack",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run content:check",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('ramp.db',{force:true});require('fs').rmSync('ramp.db-wal',{force:true});require('fs').rmSync('ramp.db-shm',{force:true})\" && npm run db:seed",
    "content:check": "tsx src/lib/db/validate.ts",
    "check:gradable": "tsx scripts/check-gradable.ts",
    "check:code": "tsx scripts/check-code-items.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.14",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
